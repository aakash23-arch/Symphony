# Vendored model snapshots (fetched by scripts/fetch_models.py, ~783 MB).
assets/models/*/
!assets/models/.gitkeep
# The manifest IS committed: it is the small, reproducible record of exactly
# which pinned revisions were vendored, and drives --verify-only.
!assets/models/manifest.json

# Local speaker enrollment store (embeddings, not audio).
data/enrollment.json
data/_*.json

