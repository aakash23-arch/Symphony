# ==============================================================================
# VOICE SHIELD — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application Role: api | analysis-worker | decision-worker | all-in-one
VOICESHIELD_ROLE=all-in-one

# Environment: development | testing | production
VOICESHIELD_ENV=development
VOICESHIELD_DEBUG=true

# Host & Port for REST and WebSocket API
VOICESHIELD_HOST=0.0.0.0
VOICESHIELD_PORT=8000

# CORS Configuration (comma-separated origins)
VOICESHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
VOICESHIELD_LOG_LEVEL=INFO
VOICESHIELD_LOG_FORMAT=json

# Redis Configuration (Streams & Pub/Sub broker)
VOICESHIELD_REDIS_URL=redis://localhost:6379/0
VOICESHIELD_REDIS_MAX_CONNECTIONS=20
VOICESHIELD_REDIS_STREAM_MAXLEN=10000

# SQLite Persistence File Path
VOICESHIELD_SQLITE_PATH=data/voiceshield.sqlite3

# Audio DSP Ingestion Constants
VOICESHIELD_AUDIO_SAMPLE_RATE=16000
VOICESHIELD_AUDIO_CHANNELS=1
VOICESHIELD_AUDIO_FRAME_MS=20
VOICESHIELD_AUDIO_WINDOW_MS=1000
VOICESHIELD_AUDIO_HOP_MS=250

# ML Inference & Model Storage
VOICESHIELD_MODELS_DIR=assets/models
VOICESHIELD_DEVICE=cpu
VOICESHIELD_TORCH_THREADS=4

# Policy & Threshold Configuration
VOICESHIELD_POLICY_VERSION=1.0.0
VOICESHIELD_RISK_THRESHOLD_WARN=0.45
VOICESHIELD_RISK_THRESHOLD_CRIT=0.75
